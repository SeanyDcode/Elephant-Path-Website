---
import '@fontsource-variable/lora';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

interface Props {
  title: string; // Page name, e.g. "About". " | The Elephant Path" is added.
  fullTitle?: string; // A complete title, used exactly as given.
  description: string;
  isHome?: boolean;
  noindex?: boolean;
  // Blog posts: shared as articles, with their publish date and extra
  // structured data.
  article?: { published: Date; headline: string };
}
const { title, description, isHome = false, noindex = false, article } = Astro.props;

const fullTitle = Astro.props.fullTitle ?? (isHome ? title : `${title} | ${site.name}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (path: string) => new URL(url(path), Astro.site).href;
const ogImage = abs('/og-image.png');

// Business details for search engines (schema.org). Nothing visible changes.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName,
  url: abs('/'),
  logo: abs('/icon-512.png'),
  image: ogImage,
  telephone: site.phoneHref.replace('tel:', ''),
  ...(site.email ? { email: site.email } : {}),
  areaServed: { '@type': 'State', name: 'Michigan' },
  priceRange: '$70–$140',
  sameAs: [site.links.psychologyToday],
  founder: {
    '@type': 'Person',
    name: 'Sandra Dougherty',
    jobTitle: 'Licensed Master Social Worker',
  },
};
const blogPosting = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.headline,
  datePublished: article.published.toISOString(),
  url: canonical.href,
  image: ogImage,
  author: { '@type': 'Person', name: 'Sandra Dougherty' },
  publisher: { '@type': 'Organization', name: site.legalName, logo: abs('/icon-512.png') },
};

// Keep search engines away from the prototype address. Remove at launch
// by setting CUSTOM_DOMAIN_LIVE in site.config.mjs.
const isPrototype = !Astro.site?.hostname.endsWith('walktheelephantpath.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPrototype) && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#F8F7F3" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Elephant Path" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {blogPosting && <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Gentle fade-and-rise as sections scroll into view.
      // Skipped entirely when the visitor prefers reduced motion.
      const items = document.querySelectorAll('.reveal');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        // Only now is it safe to hide content until it scrolls into view.
        document.documentElement.classList.add('reveal-ready');
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
