---
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, focusAreas, alsoSupport } from '../config/site';
import { url } from '../lib/url';

interface Props {
  title: string; // Page name, e.g. "About". " | The Elephant Path" is added.
  fullTitle?: string; // A complete title, used exactly as given.
  description: string;
  isHome?: boolean;
  noindex?: boolean;
  // Blog posts: shared as articles, with their publish date and extra
  // structured data.
  article?: { published: Date; modified?: Date; headline: string };
}
const { title, description, isHome = false, noindex = false, article } = Astro.props;

const fullTitle = Astro.props.fullTitle ?? (isHome ? title : `${title} | ${site.name}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (path: string) => new URL(url(path), Astro.site).href;
const ogImage = abs('/og-image.png');
const isHomePage = Astro.url.pathname === url('/');

// Details for search engines (schema.org). Nothing visible changes.
// Everything here is already stated on the site or in the build brief.
// The practice, its clinician and the website are linked to one another by
// their "@id", so Google can tell they belong together.
const practiceId = `${abs('/')}#practice`;
const clinicianId = `${abs('/about/')}#sandra`;
const websiteId = `${abs('/')}#website`;

// The topics the practice supports: the focus areas, then "I also support".
const topicsSupported = [
  ...new Set(['Grief counseling', ...focusAreas.map((area) => area.title), ...alsoSupport]),
];

const business = {
  '@type': 'ProfessionalService',
  '@id': practiceId,
  name: site.legalName,
  alternateName: site.name,
  description:
    'Private pay telehealth counseling for teens and adults anywhere in Michigan, with a focus on grief and loss, serious illness, end-of-life care, caregiver support, and life transitions.',
  url: abs('/'),
  logo: abs('/icon-512.png'),
  image: ogImage,
  telephone: site.phoneHref.replace('tel:', ''),
  ...(site.email ? { email: site.email } : {}),
  // Town only. The practice is telehealth, so no street address is given.
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Clarkston',
    addressRegion: 'MI',
    postalCode: '48348',
    addressCountry: 'US',
  },
  areaServed: { '@type': 'State', name: 'Michigan' },
  priceRange: '$70–$140',
  paymentAccepted: 'Credit card, HSA card',
  currenciesAccepted: 'USD',
  knowsAbout: topicsSupported,
  sameAs: [site.links.psychologyToday, site.links.linkedIn],
  founder: { '@id': clinicianId },
  employee: { '@id': clinicianId },
};
const clinician = {
  '@type': 'Person',
  '@id': clinicianId,
  name: 'Sandra Dougherty',
  honorificSuffix: 'LMSW',
  jobTitle: 'Licensed Master Social Worker – Clinical',
  url: abs('/about/'),
  worksFor: { '@id': practiceId },
  knowsAbout: topicsSupported,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Michigan' },
    { '@type': 'CollegeOrUniversity', name: 'University of Michigan–Flint' },
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'license',
    name: 'Licensed Master Social Worker – Clinical',
    recognizedBy: { '@type': 'GovernmentOrganization', name: 'State of Michigan' },
  },
  sameAs: [site.links.psychologyToday, site.links.linkedIn],
};
// The site's name, which Google can show above its search results.
// Google reads this from the home page only.
const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: abs('/'),
  name: site.name,
  alternateName: site.legalName,
  publisher: { '@id': practiceId },
};
const blogPosting = article && {
  '@type': 'BlogPosting',
  headline: article.headline,
  description,
  datePublished: article.published.toISOString(),
  dateModified: (article.modified ?? article.published).toISOString(),
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  image: ogImage,
  inLanguage: 'en-US',
  author: { '@type': 'Person', '@id': clinicianId, name: 'Sandra Dougherty', url: abs('/about/') },
  publisher: { '@id': practiceId },
  isPartOf: { '@id': websiteId },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    clinician,
    ...(isHomePage ? [website] : []),
    ...(blogPosting ? [blogPosting] : []),
  ],
};

// Keep search engines away from the prototype address. Remove at launch
// by setting CUSTOM_DOMAIN_LIVE in site.config.mjs.
const isPrototype = !Astro.site?.hostname.endsWith('walktheelephantpath.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A page kept out of search (the 404 page) shouldn't name itself the
        main copy of anything, so it gets no canonical link. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {(noindex || isPrototype) && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#F8F7F3" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Elephant Path" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />


    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Gentle fade-and-rise as sections scroll into view.
      // Skipped entirely when the visitor prefers reduced motion.
      const items = document.querySelectorAll('.reveal');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        // Only now is it safe to hide content until it scrolls into view.
        document.documentElement.classList.add('reveal-ready');
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
