---
// Layout for the Privacy Policy, Good Faith Estimate and Accessibility
// Statement. Every legal page is marked as a draft until the owner reviews it.
import BaseLayout from './BaseLayout.astro';
import ToConfirm from '../components/ToConfirm.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="section">
    <div class="container prose content legal">
      <h1>{title}</h1>
      <p><ToConfirm note="DRAFT – owner to review; not legal advice" /></p>
      <p class="muted small">
        Last updated: {updated ?? <ToConfirm note="TO CONFIRM: date" />}
      </p>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal :global(h2) {
    font-size: var(--step-2);
  }
</style>
