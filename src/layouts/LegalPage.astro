---
// Layout for the Privacy Policy, Good Faith Estimate and Accessibility
// Statement. Pages are marked as a draft until the owner approves them
// (pass draft={false} once approved).
import BaseLayout from './BaseLayout.astro';
import ToConfirm from '../components/ToConfirm.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
  draft?: boolean;
}
const { title, description, updated, draft = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="section">
    <div class="container prose content legal">
      <h1>{title}</h1>
      {
        draft && (
          <p>
            <ToConfirm note="DRAFT – owner to review; not legal advice" />
          </p>
        )
      }
      {updated && <p class="muted small">Last updated: {updated}</p>}
      {draft && !updated && <p class="muted small">Last updated: <ToConfirm note="TO CONFIRM: date" /></p>}
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal :global(h2) {
    font-size: var(--step-2);
  }
</style>
