---
// A simple stand-in for pages that are written in Phase 2.
import BaseLayout from './BaseLayout.astro';
import ToConfirm from '../components/ToConfirm.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  legal?: boolean;
}
const { title, description, legal = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="section wash">
    <div class="container prose">
      <h1>{title}</h1>
      {legal && <p><ToConfirm note="DRAFT – owner to review; not legal advice" /></p>}
      <p class="lede">This page is being written and will be ready for review in the next phase.</p>
      <slot />
      <p>
        In the meantime, you can call me at <a href={site.phoneHref}>{site.phoneDisplay}</a>, or
        <a href={url('/contact/')}>request a free consultation</a>.
      </p>
      <p><a href={url('/')}>Back to the home page</a></p>
    </div>
  </section>
</BaseLayout>
