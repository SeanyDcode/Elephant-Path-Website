---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostCard from '../../components/PostCard.astro';
import CrisisLines from '../../components/CrisisLines.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { site } from '../../config/site';
import { getPosts, getGuides, getBooks } from '../../lib/content';
import { url } from '../../lib/url';

const posts = (await getPosts()).slice(0, 3);
const guides = await getGuides();
const books = await getBooks();
---

<BaseLayout
  title="Resources"
  description="Guides, recommended reading, a monthly blog and crisis support lines for grief and loss, serious illness, end of life, caregiving and parenting in Michigan."
>
  <PageIntro
    title="Resources"
    illustration={{
      file: 'illus-resources-3x2.webp',
      ratio: '3/2',
      subject: 'Elephants resting by a quiet watering hole, a butterfly nearby',
    }}
  >
    <p class="lede">
      Trustworthy information and gentle encouragement for clients, caregivers and families. These
      resources aren’t a substitute for care, but I hope they help you feel less alone.
    </p>
  </PageIntro>

  <section class="section section--tight" aria-labelledby="crisis-lines">
    <div class="container reveal">
      <CrisisLines />
    </div>
  </section>

  <!-- Guides -->
  <section class="section" aria-labelledby="guides">
    <div class="container">
      <div class="section-head reveal">
        <h2 id="guides">Guides</h2>
        <p>Short, practical guides to some of life’s hardest seasons.</p>
      </div>
      <ul class="grid list-reset" role="list">
        {
          guides.map((g) => (
            <li class="card reveal">
              <h3>
                <a href={url(`/resources/guides/${g.id}/`)}>{g.data.title}</a>
              </h3>
              <p>{g.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Blog -->
  <section class="section band-stone" aria-labelledby="blog">
    <div class="container">
      <div class="section-head reveal">
        <h2 id="blog">Blog</h2>
        <p>New posts each month on the topics I care about most.</p>
      </div>
      {
        posts.length > 0 ? (
          <ul class="grid list-reset" role="list">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </ul>
        ) : (
          <p>The first posts are on their way.</p>
        )
      }
      <p class="cluster more-links reveal">
        <a class="btn btn-secondary" href={url('/resources/blog/')}>All blog posts</a>
        <a href={url('/resources/blog/#suggest')}>Suggest a topic</a>
      </p>
    </div>
  </section>

  <!-- Library -->
  <section class="section" aria-labelledby="library">
    <div class="container split">
      <div class="prose reveal">
        <h2 id="library">Library</h2>
        <p>
          Books I recommend on grief, illness, caregiving, parenting and change, sorted by topic.
          {books.length === 1 ? 'There is currently 1 book' : `There are currently ${books.length} books`} in
          the library.
        </p>
        <p><a class="btn btn-secondary" href={url('/resources/library/')}>Browse the library</a></p>
      </div>
      <section class="panel reveal" aria-labelledby="documents">
        <h2 id="documents" class="panel-title">Handouts</h2>
        <p>Printable handouts will be shared here.</p>
        <p><ToConfirm note="OWNER TO PROVIDE: handouts (accessible PDFs)" /></p>
      </section>
    </div>
  </section>

  <!-- Current clients -->
  <section class="section section--tight band-sage" aria-labelledby="portal">
    <div class="container prose reveal">
      <h2 id="portal">Current clients</h2>
      <p>
        Complete paperwork, send secure messages, view statements and make payments in your client
        portal.
      </p>
      <p>
        <ExternalLink href={site.links.clientPortal} newTab class="btn btn-primary">Go to the Client Portal</ExternalLink>
      </p>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>

<style>
  .list-reset {
    list-style: none;
    padding: 0;
  }
  .more-links {
    margin-top: var(--space-l);
    gap: var(--space-m);
  }
  .panel-title {
    font-size: var(--step-2);
  }
</style>
