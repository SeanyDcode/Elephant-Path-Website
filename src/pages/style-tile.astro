---
// Style tile: a one-page overview of the visual design for owner review.
// Not linked from the menu, and hidden from search engines.
import BaseLayout from '../layouts/BaseLayout.astro';
import PathDivider from '../components/PathDivider.astro';
import IllustrationPlaceholder from '../components/IllustrationPlaceholder.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ToConfirm from '../components/ToConfirm.astro';
import { colors, contrast } from '../lib/tokens.js';

const bg = '#F8F7F3';
---

<BaseLayout
  title="Style tile"
  description="The Elephant Path visual design: colours, type, buttons, form fields, and cards."
  noindex
>
  <section class="section section--tight wash">
    <div class="container prose">
      <h1>Style tile</h1>
      <p class="lede">
        A one-page view of the look and feel: colours, type, buttons, form fields, and cards. Palette:
        M2 “River stone.”
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="colours">
    <div class="container">
      <h2 id="colours">Colours</h2>
      <p class="muted">
        The contrast figure shows how readable each colour is on the cream page background. Text
        needs at least 4.5:1. Colours marked “decorative only” are never used for text.
      </p>
      <ul class="swatches" role="list">
        {
          colors.map((c) => (
            <li class="swatch">
              <div class="chip" style={`background:${c.hex}`}>
                <span>{c.hex}</span>
              </div>
              <div class="swatch-meta">
                <code>{c.token}</code>
                <span class="small">{c.use}</span>
                <span class="small muted">
                  {contrast(c.hex, bg).toFixed(1)}:1 on cream
                  {c.decorative && ' · decorative only'}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PathDivider />

  <section class="section section--tight" aria-labelledby="type">
    <div class="container">
      <h2 id="type">Type</h2>
      <div class="type-grid">
        <div class="stack">
          <p class="small muted">Headings: Lora (warm serif)</p>
          <p class="t-h1" aria-hidden="true">Mental wellness for the modern world.</p>
          <p class="t-h2" aria-hidden="true">Getting started is simple</p>
          <p class="t-h3" aria-hidden="true">Grief and loss</p>
          <p class="t-h4" aria-hidden="true">A smaller heading</p>
        </div>
        <div class="stack prose">
          <p class="small muted">Body: Nunito Sans (humanist sans), 18px, line height 1.6</p>
          <p class="lede">A larger lead paragraph introduces a section in a calm, clear voice.</p>
          <p>
            Body text is set at a comfortable size with room between lines. Lines stay between 60
            and 75 characters so they’re easy to read. <a href="#type">Links are olive and underlined</a>.
          </p>
          <p class="small muted">Small print, such as a license number: LMSW #6801089986.</p>
          <p>
            Owner note marker: <ToConfirm />
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight band-white" aria-labelledby="buttons">
    <div class="container stack">
      <h2 id="buttons">Buttons and links</h2>
      <div class="cluster">
        <a class="btn btn-primary" href="#buttons">Primary button</a>
        <a class="btn btn-secondary" href="#buttons">Secondary button</a>
        <a class="btn btn-primary btn-small" href="#buttons">Small button</a>
      </div>
      <p>
        <a href="#buttons">An internal link</a> ·
        <ExternalLink href="https://www.psychologytoday.com/">An external link</ExternalLink> ·
        <ExternalLink href="https://www.therapyportal.com/">A new-tab link</ExternalLink>
      </p>
      <p class="small muted">Press Tab to see the focus ring on each one.</p>
      <p><span class="tag">Tag</span> <span class="tag">Grief and loss</span></p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="forms">
    <div class="container">
      <h2 id="forms">Form fields</h2>
      <p class="muted">A preview only; this form doesn’t send anything.</p>
      <form class="demo-form" onsubmit="return false" novalidate>
        <div class="field">
          <label for="demo-name">Name <span class="req">(required)</span></label>
          <input id="demo-name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="demo-email">Email <span class="req">(required)</span></label>
          <input
            id="demo-email"
            type="email"
            autocomplete="email"
            required
            aria-invalid="true"
            aria-describedby="demo-email-error"
            value="sandra@"
          />
          <p class="error" id="demo-email-error">Please enter a full email address, like name@example.com.</p>
        </div>
        <div class="field">
          <label for="demo-time">Best time to reach you <span class="req">(optional)</span></label>
          <input id="demo-time" type="text" aria-describedby="demo-time-hint" />
          <p class="hint" id="demo-time-hint">For example, weekday mornings.</p>
        </div>
        <fieldset>
          <legend>Is it OK to leave a voicemail or text?</legend>
          <label class="choice"><input type="radio" name="demo-vm" value="yes" /> Yes</label>
          <label class="choice"><input type="radio" name="demo-vm" value="no" /> No</label>
        </fieldset>
        <p class="hint">Please don’t include health details here. We’ll talk by phone.</p>
        <button class="btn btn-primary" type="submit">Send request</button>
      </form>
    </div>
  </section>

  <section class="section section--tight band-stone" aria-labelledby="cards">
    <div class="container">
      <h2 id="cards">Cards, bands, and placeholders</h2>
      <ul class="grid" role="list">
        <li class="card">
          <h3>A card</h3>
          <p>White card on a stone band, with rounded corners and a soft shadow.</p>
          <ul class="card-links"><li><a href="#cards">A card link</a></li></ul>
        </li>
        <li class="card">
          <h3>Another card</h3>
          <p>Cards hold one idea each, with short, plain-language text.</p>
        </li>
        <li>
          <IllustrationPlaceholder
            file="illus-example-4x3.webp"
            ratio="4/3"
            subject="Watercolour illustration goes here"
          />
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight band-sage" aria-labelledby="bands">
    <div class="container prose">
      <h2 id="bands">Sage highlight band</h2>
      <p>Used for a calm, highlighted section, like “Getting started is simple.” <a href="#bands">Links</a> stay readable here.</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="notice">
    <div class="container prose">
      <h2 id="notice">Crisis notice</h2>
      <div class="crisis">
        <p>
          This site is not for emergencies. If you are in crisis, call or text <strong>988</strong> (Suicide
          &amp; Crisis Lifeline) or call <strong>911</strong>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .swatches {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin-top: var(--space-m);
  }
  .swatch {
    background: var(--surface);
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .chip {
    height: 5.5rem;
    display: flex;
    align-items: flex-end;
    padding: var(--space-xs) var(--space-s);
    border-bottom: 1px solid var(--stone-100);
  }
  .chip span {
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    font-size: var(--step--1);
    padding: 0.1em 0.6em;
    border-radius: 999px;
  }
  .swatch-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
  }
  .type-grid {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  @media (min-width: 55em) {
    .type-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .t-h1,
  .t-h2,
  .t-h3,
  .t-h4 {
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: 1.2;
  }
  .t-h1 {
    font-size: var(--step-4);
  }
  .t-h2 {
    font-size: var(--step-3);
  }
  .t-h3 {
    font-size: var(--step-2);
  }
  .t-h4 {
    font-size: var(--step-1);
  }
  .demo-form {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 32rem;
  }
  .demo-form .field + .field {
    margin-top: 0;
  }
  .demo-form button {
    align-self: flex-start;
  }
</style>
