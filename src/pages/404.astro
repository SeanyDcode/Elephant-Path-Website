---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="section wash">
    <div class="container prose">
      <h1>This page could not be found</h1>
      <p class="lede">The link may be out of date, or the page may have moved.</p>
      <p><a href={url('/')}>Go to the home page</a></p>
    </div>
  </section>
</BaseLayout>
