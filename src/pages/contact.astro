---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Steps from '../components/Steps.astro';
import ToConfirm from '../components/ToConfirm.astro';
import { site } from '../config/site';
import hugging from '../assets/illustrations/hugging-elephants.png';
---

<BaseLayout
  title="Get started"
  description="Request a free 15-minute phone consultation with Sandra Dougherty, LMSW. Telehealth therapy for teens and adults anywhere in Michigan. Call, text, or email, and I’ll reach out by the end of the next business day."
>
  <PageIntro
    title="Get started"
    illustration={{
      src: hugging,
      alt: 'Watercolor of a mother elephant wrapping her trunk around her calf',
    }}
  >
    <p class="lede">
      Reaching out takes courage. I’m glad you’re here! The first step is a free, 15-minute phone
      consultation, with no commitment.
    </p>
  </PageIntro>

  <section class="section section--tight" aria-labelledby="reach">
    <div class="container">
      <div class="panel reach reveal">
        <h2 id="reach">Call, text, or email</h2>
        <p>Reach out whichever way is easiest for you.</p>
        <ul class="plain-list contact-list">
          <li>{site.clinician}</li>
          <li>
            Phone: <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </li>
          <li>
            Email: {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <ToConfirm note="TO CONFIRM: practice email" />}
          </li>
        </ul>
        <p class="small muted">
          Please keep health details out of texts and email. We’ll talk about what brings you here by
          phone.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight band-sage" aria-labelledby="next">
    <div class="container">
      <h2 id="next" class="center steps-heading">What happens next</h2>
      <Steps />
    </div>
  </section>
</BaseLayout>

<style>
  .steps-heading {
    margin-bottom: var(--space-l);
  }
  .reach {
    max-width: var(--measure);
  }
  .reach h2 {
    font-size: var(--step-2);
  }
  .reach > * + * {
    margin-top: var(--space-m);
  }
  .contact-list li {
    min-height: 44px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.3em;
  }
</style>
