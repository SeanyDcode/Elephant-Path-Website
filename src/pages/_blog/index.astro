---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { getPosts } from '../../lib/content';
import { site } from '../../config/site';

const posts = await getPosts();
const usedTopics = [...new Set(posts.flatMap((p) => p.data.categories))];
const suggestHref = site.email
  ? `mailto:${site.email}?subject=${encodeURIComponent('Suggested Blog Topic')}`
  : null;
---

<BaseLayout
  title="Blog: Grief, Caregiving & Life Changes"
  fullTitle="Blog: Grief, Caregiving & Life Changes | The Elephant Path"
  description="Monthly posts from Sandra Dougherty, LMSW, on grief and loss, living with illness, end of life, caregiving, parenting, and life transitions."
>
  <PageIntro title="Blog">
    <p class="lede">
      Monthly reflections and practical ideas on grief, illness, caregiving, parenting, and change.
    </p>
  </PageIntro>

  <section class="section section--tight" aria-labelledby="posts">
    <div class="container">
      <h2 id="posts" class="visually-hidden">Posts</h2>
      <CategoryFilter list="post-list" noun={['post', 'posts']} categories={usedTopics} />
      <ul class="grid list-reset" id="post-list" role="list">
        {posts.map((post) => <PostCard post={post} headingLevel="h3" />)}
      </ul>
      <p id="post-list-empty" class="empty" hidden={posts.length > 0}>
        There are no posts on this topic yet. Please check back soon, or suggest a topic below.
      </p>
    </div>
  </section>

  <section class="section section--tight band-white" id="suggest" aria-labelledby="suggest-title">
    <div class="container narrow prose reveal">
      <h2 id="suggest-title">Suggest a topic</h2>
      <p>
        Is there something you’d like me to write about? I’d love to hear your ideas. Your questions
        and experiences help shape what I share here, so please don’t hesitate to reach out.
      </p>
      <p class="small muted">Please don’t include personal health details in your email.</p>
      {
        suggestHref && (
          <p>
            <a class="btn btn-primary" href={suggestHref}>
              Email a blog topic suggestion
            </a>
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .list-reset {
    list-style: none;
    padding: 0;
  }
  .empty {
    margin-top: var(--space-m);
  }
  .narrow {
    max-width: 44rem;
  }
</style>
