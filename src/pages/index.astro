---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PathDivider from '../components/PathDivider.astro';
import IllustrationPlaceholder from '../components/IllustrationPlaceholder.astro';
import Steps from '../components/Steps.astro';
import logo from '../assets/brand/logo-full.png';
import { site } from '../config/site';
import { url } from '../lib/url';
---

<BaseLayout
  isHome
  title="The Elephant Path | Telehealth therapy in Michigan"
  description="Compassionate, private pay telehealth therapy for teens and adults anywhere in Michigan. Grief and loss, illness, end of life, caregiver support, parenting and life transitions."
>
  <!-- Hero -->
  <section class="hero wash" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <Picture
        src={logo}
        alt="The Elephant Path"
        formats={['avif', 'webp']}
        width={440}
        widths={[320, 480, 640, 880]}
        sizes="(min-width: 60em) 440px, min(80vw, 420px)"
        class="hero-logo"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-text">
        <h1 id="hero-title">{site.headline}</h1>
        <p class="lede">
          I offer compassionate therapy by telehealth for teens and adults anywhere in Michigan, so
          you can get support from a place where you already feel at home.
        </p>
        <div class="cluster hero-actions">
          <a class="btn btn-primary" href={url('/contact/')}>Request a free consultation</a>
          <a class="btn btn-secondary" href={url('/about/#why-private-pay')}>Why private pay?</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Welcome -->
  <section class="section" aria-labelledby="welcome-title">
    <div class="container welcome">
      <div class="prose reveal">
        <h2 id="welcome-title">Welcome. I’m glad you’re here.</h2>
        <p>
          The Elephant Path was created with one goal: to offer care that is <strong
            >individualized, accessible, and affordable</strong
          >.
        </p>
        <p>
          As an independent private pay practice, I can focus fully on <strong
            >client centered care</strong
          >, without many of the limits that can come with managed care. My hope is that this
          creates a more personal and transparent experience for every client.
        </p>
        <p>
          Whatever brought you here, it would be an honor to walk alongside you as you work toward
          what matters to you.
        </p>
        <p class="signature">Sandra Dougherty, LMSW</p>
      </div>
      <div class="reveal">
        <IllustrationPlaceholder
          file="illus-home-welcome-4x3.webp"
          ratio="4/3"
          subject="Mother elephant and her baby walking together on a soft path"
        />
      </div>
    </div>
  </section>

  <PathDivider />

  <!-- Getting started is simple -->
  <section class="section band-sage" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head center reveal">
        <h2 id="steps-title">Getting started is simple</h2>
        <p>Reaching out can be the hardest part. Here is what happens next.</p>
      </div>
      <Steps />
      <p class="center steps-cta">
        <a class="btn btn-primary" href={url('/contact/')}>Request a free consultation</a>
      </p>
    </div>
  </section>

  <!-- An affirming space -->
  <section class="section section--tight band-stone" aria-labelledby="affirming-title">
    <div class="container affirming reveal">
      <svg class="affirming-mark" aria-hidden="true" focusable="false" viewBox="0 0 48 40" width="48" height="40">
        <path d="M24 22C12 2 2 8 6 20s14 10 18 2z" fill="var(--sage-100)" stroke="var(--logo-green)" stroke-width="1.5"></path>
        <path d="M24 22C36 2 46 8 42 20s-14 10-18 2z" fill="var(--yellow-200)" stroke="var(--logo-green)" stroke-width="1.5"></path>
        <path d="M24 22c-6 4-8 12-4 16M24 22c6 4 8 12 4 16" fill="none" stroke="var(--logo-green)" stroke-width="1.5"></path>
      </svg>
      <div class="prose">
        <h2 id="affirming-title">An affirming space</h2>
        <p>
          The Elephant Path is an affirming space for everyone. You are welcome here exactly as you
          are.
        </p>
      </div>
    </div>
  </section>

  <!-- Meet Sandra -->
  <section class="section" aria-labelledby="meet-title">
    <div class="container meet">
      <div class="headshot reveal">
        <IllustrationPlaceholder
          file="headshot-sandra-1x1.webp"
          ratio="1/1"
          subject="Headshot of Sandra Dougherty (owner to provide)"
        />
      </div>
      <div class="prose reveal">
        <h2 id="meet-title">Meet Sandra</h2>
        <p>
          I’m Sandra Dougherty, a Licensed Master Social Worker with 18 years of experience. I began
          my career as a medical social worker in oncology and hospice, and that work still shapes
          how I walk alongside my clients today.
        </p>
        <p><a href={url('/about/')}>More about me and my approach</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .hero-inner {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    justify-items: center;
    text-align: center;
  }
  .hero :global(.hero-logo),
  .hero :global(.hero-logo img) {
    width: min(80vw, 420px);
    height: auto;
  }
  .hero-text {
    max-width: 36rem;
  }
  .hero-text > * + * {
    margin-top: var(--space-m);
  }
  .hero-actions {
    justify-content: center;
    margin-top: var(--space-l);
  }
  @media (min-width: 60em) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
      justify-items: start;
      text-align: left;
    }
    .hero :global(.hero-logo),
    .hero :global(.hero-logo img) {
      width: 100%;
      max-width: 440px;
      justify-self: center;
    }
    .hero-actions {
      justify-content: flex-start;
    }
  }

  /* Welcome */
  .welcome {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .signature {
    font-family: var(--font-heading);
    font-style: italic;
    color: var(--charcoal);
  }
  @media (min-width: 55em) {
    .welcome {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-xl);
    }
  }

  .steps-cta {
    margin-top: var(--space-l);
  }

  /* Affirming */
  .affirming {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
  }
  .affirming-mark {
    flex: none;
    margin-top: 0.4rem;
  }

  /* Meet Sandra */
  .meet {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .headshot {
    width: min(100%, 18rem);
  }
  .headshot :global(.illus-ph) {
    border-radius: 50%;
  }
  @media (min-width: 45em) {
    .meet {
      grid-template-columns: auto 1fr;
      gap: var(--space-xl);
    }
  }
</style>
