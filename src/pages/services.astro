---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import FeeTable from '../components/FeeTable.astro';
import { focusAreas, alsoSupport, paymentCards } from '../config/site';
import headToHead from '../assets/illustrations/head-to-head-elephants.png';
import { url } from '../lib/url';
---

<BaseLayout
  title="Services & Fees"
  description="Telehealth counseling across Michigan for grief and loss, chronic and terminal illness, end of life, caregiver support, parenting, and life transitions. Clear, private pay fees and a free 15-minute consultation."
>
  <PageIntro
    title="Services & Fees"
    illustration={{
      src: headToHead,
      alt: 'Watercolor of a mother elephant and her calf resting their heads together',
    }}
  >
    <p class="lede">
      I offer compassionate and evidence-based care for people facing loss, illness, and change, with
      clear fees and no surprises.
    </p>
    <p><a href="#fees">Skip to fees</a></p>
  </PageIntro>

  <!-- Who I work with -->
  <section class="section section--tight band-white" aria-labelledby="who">
    <div class="container prose reveal">
      <h2 id="who">Who I work with</h2>
      <ul class="check-list">
        <li>Teens and adults of all ages</li>
        <li>Individuals and families</li>
        <li>Telehealth only, for people located in Michigan</li>
      </ul>
    </div>
  </section>

  <!-- Focus areas -->
  <section class="section" aria-labelledby="focus">
    <div class="container">
      <div class="section-head reveal">
        <h2 id="focus">How I can help</h2>
        <p>These are the areas I focus on most.</p>
      </div>
      <ul class="focus-grid" role="list">
        {
          focusAreas.map((area) => (
            <li class="card reveal" id={area.id}>
              <h3>
                {area.title}
              </h3>
              <p>{area.description}</p>
            </li>
          ))
        }
      </ul>

      <div class="also reveal">
        <h3>I also support people with</h3>
        <ul class="also-list" role="list">
          {alsoSupport.map((item) => <li class="tag">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Fees -->
  <section class="section band-stone" id="fees" aria-labelledby="fees-title">
    <div class="container split">
      <div class="reveal">
        <h2 id="fees-title">Fees</h2>
        <p class="fees-intro">Clear prices, known before care begins.</p>
        <FeeTable />
      </div>
      <div class="stack reveal">
        <div class="panel">
          <h3>Paying for sessions</h3>
          <p>
            Payment is due at the time of service and is securely processed through my electronic
            health record (EHR) system.
          </p>
          <p>I accept {paymentCards.slice(0, -1).join(', ')}, and {paymentCards.at(-1)}.</p>
        </div>
        <div class="panel">
          <h3>Sliding scale</h3>
          <p>
            A limited number of reduced-fee appointments are available for people with differing
            financial needs. If cost is a concern, we can discuss options during your free consultation.
          </p>
        </div>
        <div class="panel">
          <h3>Insurance</h3>
          <p>
            The Elephant Path does not bill insurance or provide superbills. I know this is a change for
            some people. I chose this model because it keeps your care personal and private, with costs you know up front.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Working with minors -->
  <section class="section section--tight" aria-labelledby="minors">
    <div class="container prose reveal">
      <h2 id="minors">Working with minors</h2>
      <p>
        I enjoy working with teens, and I believe parents and caregivers are an essential part of their
        support.
      </p>
    </div>
  </section>

  <!-- Good Faith Estimate -->
  <section class="section section--tight band-white" aria-labelledby="gfe">
    <div class="container reveal">
      <h2 id="gfe">Good Faith Estimate</h2>
      <p class="gfe-intro">
        Because I don’t bill insurance, you have the right to a Good Faith Estimate of your expected costs.{' '}
        <a href={url('/good-faith-estimate/')}>Learn more about the Good Faith Estimate notice</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* Seven cards in even rows: one column on phones, two on tablets (the
     last card spans both), four then three on wide screens (last row
     centered). No card sits alone at the left. */
  .focus-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40em) {
    .focus-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .focus-grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64em) {
    .focus-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
    .focus-grid > li {
      flex: 0 0 calc((100% - 3 * var(--space-m)) / 4);
    }
  }
  .focus-grid > li {
    scroll-margin-top: var(--space-l);
  }
  .also {
    margin-top: var(--space-xl);
  }
  .also h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }
  .also-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .also-list .tag {
    font-size: var(--step-0);
    padding: 0.25em 0.9em;
  }
  .fees-intro {
    margin-block: var(--space-xs) var(--space-m);
  }
  .panel h3 {
    font-size: var(--step-1);
  }
  .gfe-intro {
    max-width: var(--measure);
    margin-block: var(--space-s) var(--space-m);
  }
</style>
