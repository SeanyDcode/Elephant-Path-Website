---
// Decorative section divider: the winding path and butterfly from the logo.
interface Props {
  butterfly?: boolean;
}
const { butterfly = true } = Astro.props;
---

<div class="path-divider" aria-hidden="true">
  <svg viewBox="0 0 600 60" width="600" height="60" focusable="false">
    <path
      d="M10 44c40-18 70 8 110-2s52-30 92-26 50 28 96 26 62-26 104-24 56 22 92 18 58-14 86-10"
      fill="none"
      stroke="var(--stone-400)"
      stroke-width="3"
      stroke-linecap="round"></path>
    <path
      d="M40 48c30-10 60 4 90-2"
      fill="none"
      stroke="var(--sage-100)"
      stroke-width="6"
      stroke-linecap="round"
      opacity="0.9"></path>
    {
      butterfly && (
        <g transform="translate(548 8) rotate(12)">
          <path d="M0 10C-10-2-16 4-12 12s10 6 12-2z" fill="var(--sage-100)" stroke="var(--logo-green)" stroke-width="1" />
          <path d="M0 10C8-4 18 0 14 10s-10 8-14 0z" fill="var(--yellow-200)" stroke="var(--logo-green)" stroke-width="1" />
        </g>
      )
    }
  </svg>
</div>

<style>
  .path-divider {
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
  }
  .path-divider svg {
    width: min(100%, 26rem);
    height: auto;
  }
</style>
