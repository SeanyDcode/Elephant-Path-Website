---
// A watercolour illustration, served as small, fast AVIF/WebP images
// sized for the screen. `alt` describes the picture for screen readers.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, sizes = '(min-width: 55em) 40vw, 92vw', eager = false } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={80}
  widths={[400, 640, 960, 1280].filter((w) => w <= src.width)}
  sizes={sizes}
  class="illus"
  loading={eager ? 'eager' : 'lazy'}
/>

<style>
  .illus,
  :global(.illus img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
  }
</style>
