---
// The opening of an inner page: its one h1, a short introduction and,
// optionally, an illustration beside it.
import type { ImageMetadata } from 'astro';
import Illustration from './Illustration.astro';

interface Props {
  title: string;
  illustration?: { src: ImageMetadata; alt: string };
}
const { title, illustration } = Astro.props;
---

<section class="page-intro wash">
  <div class:list={['container', 'page-intro__inner', { 'has-illus': illustration }]}>
    <div class="prose">
      <h1>{title}</h1>
      <slot />
    </div>
    {
      illustration && (
        <div class="page-intro__illus reveal">
          <Illustration src={illustration.src} alt={illustration.alt} eager />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-intro {
    padding-block: var(--space-xl);
  }
  .page-intro__inner {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .page-intro__illus {
    width: 100%;
    max-width: 30rem;
  }
  @media (min-width: 55em) {
    .has-illus {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-xl);
    }
  }
</style>
