---
// A link to another website. It always opens in a new tab, and is labelled
// for screen readers as doing so.
interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
---

<a href={href} class:list={['ext', className]} target="_blank" rel="noopener"
  ><slot /><svg
    class="ext-icon"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    ><path
      d="M9 2h5v5M14 2 7.5 8.5M12 9.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path></svg
  ><span class="visually-hidden"> (opens in a new tab)</span></a
>
