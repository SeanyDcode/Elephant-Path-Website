---
// A link to another website. It's labelled for screen readers as going to
// an external site, and as opening in a new tab when `newTab` is set.
interface Props {
  href: string;
  newTab?: boolean;
  class?: string;
}
const { href, newTab = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['ext', className]}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener' : undefined}
><slot /><svg
    class="ext-icon"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    ><path
      d="M9 2h5v5M14 2 7.5 8.5M12 9.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path></svg
  ><span class="visually-hidden">{newTab ? ' (opens in a new tab)' : ' (external site)'}</span></a
>

