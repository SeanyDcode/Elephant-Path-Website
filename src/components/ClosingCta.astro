---
// The gentle invitation at the bottom of most pages.
import PathDivider from './PathDivider.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
}
const { title = 'When you’re ready, I’m here' } = Astro.props;
---

<PathDivider />
<section class="section closing wash" aria-labelledby="closing-title">
  <div class="container center prose reveal">
    <h2 id="closing-title">{title}</h2>
    <p>
      A free 15-minute phone consultation is a simple way to see if we’re a good fit. There’s no
      cost and no commitment.
    </p>
    <div class="cluster closing-actions">
      <a class="btn btn-primary" href={url('/contact/')}>Request a free consultation</a>
      <a class="btn btn-secondary" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .closing-actions {
    justify-content: center;
    margin-top: var(--space-l);
  }
</style>
