---
import { fees } from '../config/site';
---

<div class="table-wrap">
  <table class="fee-table">
    <caption class="visually-hidden">Session fees</caption>
    <thead>
      <tr>
        <th scope="col">Session</th>
        <th scope="col">Fee</th>
      </tr>
    </thead>
    <tbody>
      {
        fees.map((f) => (
          <tr class:list={{ highlight: f.highlight }}>
            <th scope="row">{f.session}</th>
            <td>{f.fee}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    max-width: 30rem;
  }
  .fee-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--surface);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }
  th,
  td {
    text-align: left;
    padding: var(--space-s) var(--space-m);
    border-bottom: 1px solid var(--stone-100);
    vertical-align: middle;
  }
  thead th {
    font-size: var(--step--1);
    color: var(--charcoal);
    background: var(--stone-100);
  }
  tbody th {
    font-weight: 700;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  td:last-child {
    font-weight: 700;
    white-space: nowrap;
    text-align: right;
  }
  thead th:last-child {
    text-align: right;
  }
  .highlight > * {
    background: var(--sage-100);
    color: var(--on-sage);
  }
  @media (max-width: 30em) {
    th,
    td {
      padding: var(--space-s);
    }
  }
</style>
