---
// "Request a free consultation" form. Collects only what's needed for a
// callback: no health details. Endpoint is set in src/config/site.ts.
import { site } from '../config/site';

const failure = `Sorry, something went wrong and your request wasn’t sent. Please call me at <a href="${site.phoneHref}">${site.phoneDisplay}</a>${site.email ? ` or email <a href="mailto:${site.email}">${site.email}</a>` : ''}.`;
---

<div class="form-wrap">
  <form
    data-form
    data-status="consult-status"
    data-endpoint={site.forms.consultEndpoint ?? undefined}
    data-success="Thank you. I’ll reach out within one business day."
    data-failure={failure}
    method="post"
    action={site.forms.consultEndpoint ?? undefined}
    aria-labelledby="consult-form-title"
  >
    <h2 id="consult-form-title" class="form-title">Request a free consultation</h2>

    <div class="error-summary" data-error-summary tabindex="-1" hidden>
      <h3 data-error-count>There is a problem with this form</h3>
      <ul></ul>
    </div>

    <div class="field">
      <label for="consult-name" data-name="name">Name <span class="req">(required)</span></label>
      <input id="consult-name" name="name" type="text" autocomplete="name" required data-check />
    </div>

    <div class="field">
      <label for="consult-email" data-name="email address">Email <span class="req">(required)</span></label>
      <input id="consult-email" name="email" type="email" autocomplete="email" required data-check />
    </div>

    <div class="field">
      <label for="consult-phone" data-name="phone number">Phone <span class="req">(required)</span></label>
      <input id="consult-phone" name="phone" type="tel" autocomplete="tel" required data-check />
    </div>

    <fieldset class="field-group">
      <legend>Is it OK to leave a voicemail or text? <span class="req">(optional)</span></legend>
      <label class="choice"><input type="radio" name="voicemail_ok" value="Yes" /> Yes</label>
      <label class="choice"><input type="radio" name="voicemail_ok" value="No" /> No</label>
    </fieldset>

    <div class="field">
      <label for="consult-time">Best time to reach you <span class="req">(optional)</span></label>
      <input id="consult-time" name="best_time" type="text" autocomplete="off" aria-describedby="consult-time-hint" />
      <p class="hint" id="consult-time-hint">For example, weekday mornings or after 3pm.</p>
    </div>

    <!-- Spam trap: hidden from people, filled in only by bots. -->
    <div class="hp" aria-hidden="true">
      <label for="consult-website">Leave this field empty</label>
      <input id="consult-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="form-note" id="consult-note">Please don’t include health details here. We’ll talk by phone.</p>
    <button class="btn btn-primary" type="submit" aria-describedby="consult-note">Send request</button>
  </form>

  <div id="consult-status" class="form-status" role="status" tabindex="-1" hidden></div>
</div>

<script>
  import '../scripts/forms';
</script>
